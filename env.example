NODE_ENV=development
PORT=8080
LOG_LEVEL=info

# Local Docker defaults. Replace these for any internet-facing deployment.
MQTT_URL=mqtt://emqx:1883
MQTT_USERNAME=syncgen_ingestor
MQTT_PASSWORD=CHANGE_ME
MQTT_TOPIC=syncgen/v1/+/+/+/telemetry

DATABASE_URL=postgres://syncgen:CHANGE_ME@timescaledb:5432/syncgen
DATABASE_SSL=false

# Allowed web-app origin. Use the real HTTPS app URL in production.
CORS_ORIGIN=http://localhost:5173

# Data becomes STALE after this many seconds without a valid packet.
STALE_AFTER_SECONDS=20

